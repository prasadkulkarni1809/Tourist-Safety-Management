<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Safer Smarter Travel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #050505;
            /* Matches the Registration Page radial glow */
            background-image: radial-gradient(circle at 50% -20%, #1e293b 0%, #050505 80%);
        }

        .glass-panel {
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .input-field {
            background: #0f1115;
            border: 1px solid #2d3139;
            color: white;
            transition: all 0.3s ease;
        }

        .input-field:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        /* Subtle animation for the login button */
        .btn-glow {
            transition: all 0.3s ease;
        }
        .btn-glow:hover {
            box-shadow: 0 0 20px rgba(37, 99, 235, 0.4);
            transform: translateY(-1px);
        }
    </style>
</head>
<body class="text-gray-200 min-h-screen flex flex-col items-center justify-center p-6">

    <div class="mb-8 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-600/10 border border-blue-500/20 mb-4">
            <i data-lucide="shield-check" class="w-8 h-8 text-blue-500"></i>
        </div>
        <h1 class="text-3xl font-bold text-white tracking-tight">Welcome Back</h1>
        <p class="text-gray-400 mt-2">Secure access to your travel dashboard</p>
    </div>

    <div class="glass-panel p-10 rounded-2xl w-full max-w-md">
        
        <form action="/login" method="POST" class="space-y-6">
            
            <div>
                <label class="block text-sm font-medium mb-2 text-gray-300">Email Address</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="mail" class="w-4 h-4 text-gray-500"></i>
                    </span>
                    <input type="email" name="email" required
                        class="input-field w-full pl-10 p-3 rounded-xl" 
                        placeholder="name@example.com">
                </div>
            </div>

            <div>
                <div class="flex justify-between mb-2">
                    <label class="text-sm font-medium text-gray-300">Password</label>
                    <a href="#" class="text-xs text-blue-400 hover:underline">Forgot password?</a>
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="lock" class="w-4 h-4 text-gray-500"></i>
                    </span>
                    <input type="password" name="password" required
                        class="input-field w-full pl-10 p-3 rounded-xl" 
                        placeholder="••••••••">
                </div>
            </div>

            <div class="flex items-center">
                <input type="checkbox" id="remember" class="w-4 h-4 rounded border-gray-700 bg-gray-900 text-blue-600 focus:ring-blue-500">
                <label for="remember" class="ml-2 text-sm text-gray-400">Keep me logged in</label>
            </div>

            <button type="submit" 
                class="btn-glow w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold p-3.5 rounded-xl transition-all shadow-lg shadow-blue-900/20">
                Sign In
            </button>

        </form>

        <div class="mt-8 pt-6 border-t border-white/5 text-center">
            <p class="text-sm text-gray-400">
                Don't have an account? 
                <a href="/register" class="text-blue-400 font-medium hover:text-blue-300 transition-colors">
                    Create one now
                </a>
            </p>
        </div>
    </div>

    <div class="fixed bottom-0 left-0 p-10 opacity-20 pointer-events-none">
        <i data-lucide="map" class="w-32 h-32 text-blue-500"></i>
    </div>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();
    </script>
</body>
</html>
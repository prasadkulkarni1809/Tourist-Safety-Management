<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | SafeTravel AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: #050505; 
            background-image: radial-gradient(circle at top right, #1e293b 0%, #050505 80%);
            margin: 0;
            overflow: hidden; 
        }
        .glass-panel { 
            background: rgba(17, 17, 17, 0.6); 
            backdrop-filter: blur(10px); 
            border: 1px solid rgba(255, 255, 255, 0.1); 
            position: relative;
            z-index: 10;
        /* ey tbfsd */

        .glass-panel {
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .input-field {
            background: #0f1115;
            border: 1px solid #2d3139;
            color: white;
            transition: all 0.3s ease;
        }
        .input-field:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }
        /* Fixed Bottom-Left Symbol */
        .map-symbol {
            position: fixed;
            bottom: 30px;
            left: 30px;
            opacity: 0.2;
            color: #3b82f6;
            z-index: 1;
            pointer-events: none;
        }
    </style>
</head>
<body class="text-gray-200 min-h-screen flex flex-col items-center justify-center p-6 relative">

    <div class="mb-8 text-center relative z-10">
        <h1 class="text-4xl font-bold text-white tracking-tight">Welcome Back</h1>
        <p class="text-gray-400 mt-2 text-lg">Secure access to your travel dashboard</p>
    </div>

    <div class="glass-panel p-10 rounded-2xl w-full max-w-md shadow-2xl">
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 text-sm flex items-center gap-3 animate-pulse">
                <i data-lucide="alert-circle" class="w-5 h-5"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-6">
            
            <div>
                <label class="block text-sm font-medium mb-2 text-gray-300">Email Address</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="mail" class="w-4 h-4 text-gray-500"></i>
                    </span>
                    <input type="email" name="email" required
                        class="input-field w-full pl-10 p-3.5 rounded-xl text-white" 
                        placeholder="name@example.com">
                </div>
            </div>

            <div>
                <div class="flex justify-between mb-2">
                    <label class="text-sm font-medium text-gray-300">Password</label>
                    <a href="#" class="text-xs text-blue-400 hover:text-blue-300 transition-colors">Forgot password?</a>
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="lock" class="w-4 h-4 text-gray-500"></i>
                    </span>
                    <input type="password" name="password" required
                        class="input-field w-full pl-10 p-3.5 rounded-xl text-white" 
                        placeholder="••••••••">
                </div>
            </div>

            <div class="flex items-center">
                <input type="checkbox" id="remember" class="w-4 h-4 rounded border-gray-700 bg-gray-900 text-blue-600 focus:ring-blue-500 cursor-pointer">
                <label for="remember" class="ml-2 text-sm text-gray-400 cursor-pointer select-none">Keep me logged in</label>
            </div>

            <button type="submit" 
                class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold p-4 rounded-xl transition-all shadow-lg shadow-blue-900/20 active:scale-[0.98]">
                Sign In
            </button>

        </form>

        <div class="mt-8 pt-6 border-t border-white/5 text-center">
            <p class="text-sm text-gray-400">
                Don't have an account? 
                <a href="/register" class="text-blue-400 font-bold hover:text-blue-300 transition-colors ml-1">
                    Create one now
                </a>
            </p>
        </div>
    </div>

    <div class="map-symbol">
        <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21 3 6"></polygon>
            <line x1="9" y1="3" x2="9" y2="18"></line>
            <line x1="15" y1="6" x2="15" y2="21"></line>
        </svg>
    </div>

    <script>
        // Initialize all Lucide icons
        lucide.createIcons();
    </script>
</body>
</html>
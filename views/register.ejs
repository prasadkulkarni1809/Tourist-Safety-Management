<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Register | Tourist Safety</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-blue-900 flex items-center justify-center px-4">

    <div class="absolute w-[500px] h-[500px] bg-blue-700 rounded-full blur-3xl opacity-30"></div>

    <div class="relative bg-white w-full max-w-md rounded-xl shadow-2xl p-8">

        <div class="text-center mb-6">
            <h1 class="text-3xl font-bold text-blue-900">Create Account</h1>
            <p class="text-gray-500 text-sm mt-1">Join the Tourist Safety Network</p>
        </div>

        <% if (typeof error !== 'undefined') { %>
            <div class="bg-red-100 text-red-600 text-sm p-2 rounded mb-4 text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/register" method="POST" class="space-y-5">

            <div>
                <label class="text-sm text-gray-600">Full Name</label>
                <input type="text" name="name" required
                    class="w-full mt-1 px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none"
                    placeholder="Enter your name">
            </div>

            <div>
                <label class="text-sm text-gray-600">Email Address</label>
                <input type="email" name="email" required
                    class="w-full mt-1 px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none"
                    placeholder="Enter your email">
            </div>

            <div>
                <label class="text-sm text-gray-600">Password</label>
                <input type="password" name="password" required
                    class="w-full mt-1 px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none"
                    placeholder="Create password">
            </div>

            <div>
                <label class="text-sm text-gray-600">Register As</label>
                <select name="role" required
                    class="w-full mt-1 px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-600 focus:outline-none">
                    <option value="">Select Role</option>
                    <option value="tourist">Tourist</option>
                    <option value="police">Police</option>
                    <option value="authority">Authority</option>
                </select>
            </div>

            <button type="submit"
                class="w-full bg-blue-800 text-white py-2 rounded-lg hover:bg-blue-900 transition duration-300">
                Register
            </button>

        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
            Already have an account?
            <a href="/login" class="text-blue-700 font-medium hover:underline">
                Log In
            </a>
        </p>

    </div>

</body>
</html>
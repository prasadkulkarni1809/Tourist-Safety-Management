<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | Safer Smarter Travel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #050505;
            background-image: radial-gradient(circle at 50% -20%, #1e293b 0%, #050505 80%);
        }
        .glass-panel {
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .input-field {
            background: #0f1115;
            border: 1px solid #2d3139;
            color: white;
            transition: all 0.3s ease;
        }
        .input-field:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }
        
        /* Role Card Base Styles */
        .role-card {
            background: #111111;
            border: 1px solid #1e293b;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
            position: relative;
        }
        .role-card:hover {
            border-color: #3b82f6;
        }

        /* Active State Styles */
        .role-card.active {
            background: #3b82f6 !important;
            border-color: #60a5fa !important;
            transform: translateY(-2px);
        }
        /* Ensure text stays bright when active */
        .role-card.active h3, 
        .role-card.active p, 
        .role-card.active i {
            color: white !important;
        }
    </style>
</head>
<body class="text-gray-200 min-h-screen flex flex-col items-center justify-center p-6">

    <h1 class="text-2xl font-medium mb-10 text-white tracking-tight text-center">
        Create your account and start experiencing <span class="text-blue-400">safer, smarter travel</span>
    </h1>

    <form action="/register" method="POST" id="registrationForm" class="grid grid-cols-1 lg:grid-cols-2 gap-8 w-full max-w-5xl">
        
        <input type="hidden" name="role" id="selectedRoleInput" value="tourist">

        <div class="glass-panel p-8 rounded-2xl">
            <div class="flex items-center gap-2 mb-6">
                <i data-lucide="user" class="w-5 h-5 text-gray-400"></i>
                <h2 class="text-xl font-semibold text-white">Choose Your Role</h2>
            </div>

            <div class="space-y-4" id="roleContainer">
                <div onclick="selectRole(this, 'tourist')" class="role-card active p-5 rounded-xl flex items-start gap-4">
                    <div class="mt-1"><i data-lucide="user-circle" class="w-8 h-8 text-white"></i></div>
                    <div>
                        <h3 class="font-bold text-lg text-white">Tourist</h3>
                        <p class="text-sm text-white opacity-80">Travelers seeking safety and assistance</p>
                    </div>
                </div>

                <div onclick="selectRole(this, 'authority')" class="role-card p-5 rounded-xl flex items-start gap-4">
                    <div class="mt-1"><i data-lucide="shield-check" class="w-8 h-8 text-gray-400"></i></div>
                    <div>
                        <h3 class="font-bold text-lg text-gray-400">Tourism Authority</h3>
                        <p class="text-sm text-gray-400">Government officials and board members</p>
                    </div>
                </div>

                <div onclick="selectRole(this, 'police')" class="role-card p-5 rounded-xl flex items-start gap-4">
                    <div class="mt-1"><i data-lucide="car" class="w-8 h-8 text-gray-400"></i></div>
                    <div>
                        <h3 class="font-bold text-lg text-gray-400">Police/Emergency Services</h3>
                        <p class="text-sm text-gray-400">Law enforcement personnel</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-panel p-8 rounded-2xl">
            <div class="flex items-center gap-2 mb-2">
                <i data-lucide="mail" class="w-5 h-5 text-gray-400"></i>
                <h2 class="text-xl font-semibold text-white">Account Details</h2>
            </div>
            
            <div class="space-y-5 mt-6">
                <div>
                    <label class="block text-sm font-medium mb-1.5">Full Name <span class="text-red-500">*</span></label>
                    <input type="text" name="name" required class="input-field w-full p-3 rounded-lg" placeholder="e.g. Dhruv Sharma">
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1.5">Email Address <span class="text-red-500">*</span></label>
                    <input type="email" name="email" required class="input-field w-full p-3 rounded-lg" placeholder="email@example.com">
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1.5">Password <span class="text-red-500">*</span></label>
                    <input type="password" name="password" minlength="6" required class="input-field w-full p-3 rounded-lg" placeholder="Min. 6 characters">
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold p-4 rounded-xl transition-all shadow-lg shadow-blue-900/40 mt-4">
                    Register Account
                </button>
            </div>

            <p class="mt-6 text-center text-sm text-gray-400">
                Already have an account? <a href="/login" class="text-blue-400 hover:underline">Login here</a>
            </p>
        </div>
    </form>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        function selectRole(element, roleValue) {
            // 1. Update the hidden input value for the backend
            document.getElementById('selectedRoleInput').value = roleValue;

            // 2. Clear "active" state from all cards
            const allCards = document.querySelectorAll('.role-card');
            allCards.forEach(card => {
                card.classList.remove('active');
                
                // Reset colors for non-active cards
                const title = card.querySelector('h3');
                const text = card.querySelector('p');
                const icon = card.querySelector('i');
                
                title.classList.replace('text-white', 'text-gray-400');
                text.classList.replace('text-white', 'text-gray-400');
                if (icon) icon.classList.add('text-gray-400');
            });

            // 3. Set "active" state for the clicked card
            element.classList.add('active');
            
            // Set colors for the active card
            const activeTitle = element.querySelector('h3');
            const activeText = element.querySelector('p');
            const activeIcon = element.querySelector('i');
            
            activeTitle.classList.replace('text-gray-400', 'text-white');
            activeText.classList.replace('text-gray-400', 'text-white');
            if (activeIcon) activeIcon.classList.remove('text-gray-400');
        }
    </script>
</body>
</html>
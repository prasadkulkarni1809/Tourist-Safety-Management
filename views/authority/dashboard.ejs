<!DOCTYPE html>
<html>

<%- include('../partials/authority/head') %>

<body class="bg-slate-950 text-white">

<!-- Mobile Toggle Button -->
<button onclick="toggleSidebar()"
        class="md:hidden fixed top-4 left-4 z-50 bg-slate-800 p-2 rounded-lg">
  ☰
</button>

<div class="flex h-screen">

  <!-- Sidebar -->
  <%- include('../partials/authority/authoritySidebar') %>

  <!-- Main Content -->
  <div class="flex-1 p-8 overflow-y-auto ">

    <!-- Welcome Section -->
    <div class="mb-10">
      <h1 class="text-3xl font-bold">
        Welcome, <span class="text-blue-400"><%= user?.name %></span>
      </h1>
      <p class="text-slate-400 mt-2">
        Here’s your authority dashboard overview.
      </p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">

      <div class="bg-slate-800 p-6 rounded-xl shadow hover:shadow-lg transition">
        <p class="text-slate-400 text-sm">Active Incidents</p>
       <h2 class="text-3xl font-bold mt-2">
  <%= activeCount %>
</h2>
      </div>

      <div class="bg-slate-800 p-6 rounded-xl shadow hover:shadow-lg transition">
        <p class="text-slate-400 text-sm">Resolved</p>
      <h2 class="text-3xl font-bold mt-2">
  <%= resolvedCount %>
</h2>
      </div>

      <div class="bg-slate-800 p-6 rounded-xl shadow hover:shadow-lg transition">
        <p class="text-slate-400 text-sm">Pending</p>
         <h2 class="text-3xl font-bold mt-2">
  <%= pendingCount %>
</h2>
      </div>

      <div class="bg-slate-800 p-6 rounded-xl shadow hover:shadow-lg transition">
        <p class="text-slate-400 text-sm">Total Tourists</p>
        <h2 class="text-3xl font-bold mt-2">
  <%= touristCount %>
</h2>

    </div>

    <!-- Recent Activity Section -->
    <div class="bg-slate-900 p-6 rounded-xl">
      <h2 class="text-xl font-semibold mb-4">Recent Incidents</h2>

      <div class="overflow-x-auto">
      <tbody>
  <% recentIncidents.forEach(incident => { %>
    <tr class="border-b border-slate-800 hover:bg-slate-800">
      <td class="py-3">
        <%= incident.tourist?.name || "Unknown" %>
      </td>
      <td><%= incident.location %></td>
      <td class="text-yellow-400 capitalize">
        <%= incident.status %>
      </td>
      <td>
        <%= new Date(incident.createdAt).toLocaleString() %>
      </td>
    </tr>
  <% }) %>
</tbody>
      </div>
    </div>

  </div>
</div>

<!-- Sidebar Toggle Script -->
<script>
  function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    sidebar.classList.toggle('-translate-x-full');
  }
</script>

</body>
</html>